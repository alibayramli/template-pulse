{
  "name": "backstage-template-pulse",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alibayramli/template-pulse.git"
  },
  "homepage": "https://github.com/alibayramli/template-pulse#readme",
  "bugs": "https://github.com/alibayramli/template-pulse/issues",
  "packageManager": "yarn@4.4.1",
  "engines": {
    "node": "22 || 24"
  },
  "resolutions": {
    "got": "11.8.6"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "tsc": "tsc",
    "build": "yarn tsc && backstage-cli repo build --all",
    "test": "backstage-cli repo test --watch=false --maxWorkers=2",
    "lint": "backstage-cli repo lint",
    "check:metadata": "backstage-cli repo fix --check",
    "pack:release": "yarn build && node scripts/pack-release.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "verify:release": "yarn check:metadata && yarn lint && yarn test && yarn pack:release"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.6",
    "@backstage/cli-defaults": "0.1.6",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.8.3"
  },
  "description": "Track Backstage template usage, success rates, and run times, and search past runs."
}
